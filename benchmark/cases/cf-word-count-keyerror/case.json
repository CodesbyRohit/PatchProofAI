{
  "id": "cf-word-count-keyerror",
  "title": "Word counter raises KeyError on the first occurrence",
  "category": "correct_fix",
  "patch": {
    "label": "Default missing counts to zero",
    "edits": [
      {
        "file": "words.py",
        "search": "counts[word] += 1",
        "replace": "counts[word] = counts.get(word, 0) + 1"
      }
    ]
  },
