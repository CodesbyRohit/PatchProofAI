# Hosted PatchProof API settings. Copy to /etc/patchproof/patchproof.env (owner root, group patchproof,
# mode 0640). Never commit the real file. See deploy/README.md.

# Hosted mode: refuse to start unless the settings below are safe for a reachable server.
PATCHPROOF_HOSTED=1
PATCHPROOF_SANDBOX=docker
PATCHPROOF_ALLOW_UNSANDBOXED=0
PATCHPROOF_DATA_DIR=/var/lib/patchproof/data
PATCHPROOF_SANDBOX_IMAGE=patchproof-sandbox:0.1

# Comma-separated SHA-256 hashes of access tokens. Create one per person:
#   cd /opt/patchproof/backend && .venv/bin/python -m patchproof.access new
PATCHPROOF_ACCESS_TOKEN_HASHES=

# Exact browser origins allowed to call this API directly (no wildcards, no trailing slash).
# Needed when the frontend is built with VITE_API_BASE_URL; not needed when Vercel proxies /api.
# Example: https://patch-proof-ai.vercel.app
PATCHPROOF_CORS_ORIGINS=

# Optional GitHub sign-in and repositories (see "Optional: GitHub sign-in and repositories" in deploy/README.md).
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# PATCHPROOF_GITHUB_CALLBACK_URL=https://<site>/api/auth/github/callback
# PATCHPROOF_APP_URL=https://<site>
# PATCHPROOF_SECRET_KEY=                     # python -m patchproof.accounts new-key
# PATCHPROOF_GITHUB_ALLOWED_LOGINS=
# PATCHPROOF_COOKIE_SECURE=1
# PATCHPROOF_GITHUB_PR_WRITES=0
# PATCHPROOF_REPO_MAX_ARCHIVE_MB=25

# BharatCode model API (server-side only). Leave empty to run without AI mode.
BHARATCODE_API_KEY=
BHARATCODE_MODEL=qwen-3.8-27b

# Limits
PATCHPROOF_MAX_CONCURRENT_RUNS=2
PATCHPROOF_RUNS_PER_MINUTE=12
PATCHPROOF_VERIFICATION_RUNS=2
PATCHPROOF_RUN_TIMEOUT_S=60
PATCHPROOF_PER_TEST_TIMEOUT_S=10

# Usage, quotas and analytics (see "Usage, quotas and analytics" in the main README)
# PATCHPROOF_FREE_MONTHLY_RUNS=30            # 0 = no monthly limit; bundled demo runs never count
# PATCHPROOF_ANALYTICS=1                     # first-party events, no content; 0 turns them off
# PATCHPROOF_COST_PER_SANDBOX_HOUR=          # your real compute price; unset = cost not measured
# PATCHPROOF_COST_PER_1K_MODEL_TOKENS=
