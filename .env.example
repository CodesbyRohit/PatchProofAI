# Copy to backend/.env and fill in. Never commit the real file.

# BharatCode model API (server-side only). Get a key at https://bharatcode.ai/account
BHARATCODE_API_KEY=
BHARATCODE_MODEL=qwen-3.8-27b
# BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# BHARATCODE_REASONING_EFFORT=
# BHARATCODE_MAX_OUTPUT_TOKENS=16000
# BHARATCODE_TIMEOUT_S=180

# Execution sandbox: auto | docker | local
#   auto   - Docker when available; otherwise only bundled examples with bundled patches run
#   docker - require Docker for everything
#   local  - never use Docker (bundled code only, unless the override below is set)
PATCHPROOF_SANDBOX=auto
PATCHPROOF_SANDBOX_IMAGE=patchproof-sandbox:0.1

# DANGER: runs uploaded code and AI patches on the host without isolation. Development only.
PATCHPROOF_ALLOW_UNSANDBOXED=0

# Hosted deployments: see deploy/README.md and deploy/patchproof.env.example.
# PATCHPROOF_HOSTED=1                      # refuse to start without tokens, Docker and a data directory
# PATCHPROOF_ACCESS_TOKEN_HASHES=          # from: uv run python -m patchproof.access new
# PATCHPROOF_CORS_ORIGINS=                 # exact frontend origins, e.g. https://patch-proof-ai.vercel.app
# PATCHPROOF_DATA_DIR=                     # default: backend/.data
# GitHub sign-in and repositories: see deploy/patchproof.env.example and deploy/README.md.

# Verification settings
PATCHPROOF_VERIFICATION_RUNS=2
PATCHPROOF_MAX_AI_ATTEMPTS=2
PATCHPROOF_RUN_TIMEOUT_S=60
PATCHPROOF_PER_TEST_TIMEOUT_S=10
